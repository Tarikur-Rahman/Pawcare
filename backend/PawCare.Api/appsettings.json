{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning"
    }
  },
  "ConnectionStrings": {
    "PawCare": ""
  },
  "Jwt": {
    "Issuer": "PawCare.Api",
    "Audience": "PawCare.Clients",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "RequestsPerMinute": 120
  },
  "Health": {
    "OracleTimeoutSeconds": 5
  },
  "OpenApi": {
    "Enabled": false
  },
  "Workers": {
    "Reminders": {
      "Enabled": false,
      "PollSeconds": 60,
      "BatchSize": 100
    },
    "Outbox": {
      "Enabled": false,
      "EmailEnabled": false,
      "PollSeconds": 10,
      "BatchSize": 25,
      "MaxAttempts": 7
    },
    "Inventory": {
      "Enabled": false,
      "PollSeconds": 120,
      "BatchSize": 25
    }
  },
  "Push": {
    "Expo": {
      "Enabled": false
    }
  },
  "Email": {
    "Enabled": false
  }
}
