# PawCare API - local example ONLY. Copy to .env, customize, and keep .env untracked.
# Run with DOTNET_ENVIRONMENT=Development (or ASPNETCORE_ENVIRONMENT=Development).
# Program.cs loads .env only in Development; production uses deployed environment/secret store.

# Local API defaults to loopback; on a trusted LAN for a physical phone,
# intentionally use ASPNETCORE_URLS=http://0.0.0.0:5080 and a restricted firewall rule.
ASPNETCORE_URLS=http://127.0.0.1:5080

# Oracle Database Free commonly uses FREEPDB1; replace host/service as needed.
# Local only: PAWCARE_APP is the schema owner created in step 000.
# Before production, provision a separate least-privilege runtime user with grants.
# Avoid using quoted values unless needed; semicolons in connection strings are supported.
ConnectionStrings__PawCare=User Id=PAWCARE_APP;Password=REPLACE_WITH_SECRET;Data Source=localhost:1521/FREEPDB1;Pooling=true;

# Generate a random >=32-byte signing key and store securely. Never commit actual keys.
# PowerShell example: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
Jwt__Issuer=PawCare.Api
Jwt__Audience=PawCare.Clients
Jwt__SigningKey=REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_PRIVATE_SECRET

# Default local web origins are in appsettings.Development.json.
# Override when needed via Cors__AllowedOrigins__0=http://localhost:3000.
RateLimiting__RequestsPerMinute=120
Health__OracleTimeoutSeconds=5
